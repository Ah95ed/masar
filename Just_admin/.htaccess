# SpacePoint root rules for Apache 2.4 / PHP-FPM
RewriteEngine On

# Enable only after HTTPS is active and APP_URL uses https.
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

<FilesMatch "\.(sql|md|log|ini|env|json)$">
    Require all denied
</FilesMatch>

Options -Indexes

# Block external hotlinking of uploaded files.
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?aksat\.shop(?:/|$) [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp|pdf)$ - [F,NC,L]